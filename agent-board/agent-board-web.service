[Unit]
Description=Agent board web (static, 127.0.0.1:7788)

[Service]
ExecStartPre=/bin/mkdir -p %h/.claude/mods-data/agent-board/web/sessions
ExecStart=/usr/bin/python3 -m http.server 7788 --bind 127.0.0.1 --directory %h/.claude/mods-data/agent-board/web
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
