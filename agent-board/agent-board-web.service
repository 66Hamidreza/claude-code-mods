[Unit]
Description=Agent board web (static + usage.json, 127.0.0.1:7788)

[Service]
ExecStartPre=/bin/mkdir -p %h/.claude/mods-data/agent-board/web/sessions
ExecStart=/usr/bin/python3 -I %h/.claude/mods/agent-board/server.py --port 7788
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
